# ─── Variables d'environnement — Clinique de la Rebecca Frontend ──────────────
# Copier ce fichier en .env.local pour le développement local.
# En production (Vercel), configurer ces variables dans le dashboard Vercel
# sous : Settings → Environment Variables

# URL du backend API (FastAPI sur Render)
NEXT_PUBLIC_API_URL=https://clinique-rebecca-api.onrender.com

# Pour développement local uniquement :
# NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── NOTE SÉCURITÉ ──────────────────────────────────────────────────────────
# Ne jamais mettre de clés secrètes (API keys, tokens) dans les variables
# NEXT_PUBLIC_* : elles sont exposées côté client.
# Les secrets doivent être dans des variables sans prefix NEXT_PUBLIC_.
