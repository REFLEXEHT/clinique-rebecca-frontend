# ─── Variables d'environnement — Clinique de la Rebecca Frontend ──────────────
# Copier ce fichier en .env.local pour le développement local.
# En production (Vercel), configurer ces variables dans le dashboard Vercel
# sous : Settings → Environment Variables

# URL du backend API côté CLIENT (utilisée en développement local uniquement)
NEXT_PUBLIC_API_URL=http://localhost:8000

# URL du backend API côté SERVEUR uniquement (proxy Next.js — jamais exposée au navigateur)
# En production : mettre https://clinique-rebecca-api.onrender.com dans Vercel
BACKEND_API_URL=https://clinique-rebecca-api.onrender.com

# ─── NOTE SÉCURITÉ ──────────────────────────────────────────────────────────
# Ne jamais mettre de clés secrètes (API keys, tokens) dans les variables
# NEXT_PUBLIC_* : elles sont exposées côté client dans le bundle JavaScript.
# Les secrets doivent être dans des variables sans préfixe NEXT_PUBLIC_.

# Clé API Anthropic (Claude) — UNIQUEMENT côté serveur, jamais exposée au navigateur
# Obtenir sur: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
