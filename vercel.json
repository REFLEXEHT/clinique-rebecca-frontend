{
  "version": 2,
  "name": "clinique-rebecca",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "regions": ["iad1"],
  "env": {
    "NEXT_SKIP_FONT_OPTIMIZATION": "true"
  },
  "build": {
    "env": {
      "NEXT_SKIP_FONT_OPTIMIZATION": "true",
      "NEXT_TELEMETRY_DISABLED": "1"
    }
  }
}
